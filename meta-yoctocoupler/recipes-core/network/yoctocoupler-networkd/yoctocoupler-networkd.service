[Unit]
Description=Yoctocoupler systemd-networkd bootstrap
Requires=systemd-networkd.service
Wants=systemd-networkd-wait-online.service systemd-resolved.service
After=systemd-networkd.service systemd-resolved.service
Before=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
